{
  "name": "hrms-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Human Resource Management System",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "test": "npm --prefix server run test && npm --prefix client run test",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
